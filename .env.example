# Copy to .env.local and fill from Supabase → Project Settings → API
# Never commit .env.local

VITE_SUPABASE_PROJECT_ID=your_project_ref
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use publishable key (sb_publishable_…) or anon JWT — not service_role
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Free basic plan for all signed-in users (default). Set to "true" to send users to /plans until they have an active/pending paid subscription.
# VITE_REQUIRE_PAID_SUBSCRIPTION=false

# Comma-separated emails treated as in-app superadmin (full access, no payment gate). DB migration also grants admin role for brightadmin77@gmail.com on sign-up.
# VITE_SUPERADMIN_EMAILS=brightadmin77@gmail.com

# Enable subscription realtime listener. In local dev this defaults to off to avoid noisy websocket cleanup warnings.
# VITE_ENABLE_SUBSCRIPTION_REALTIME=false
